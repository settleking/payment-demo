# Copy to .env and fill in. Server-side only: never commit .env.
PORT=4400
# HTTPS origin where customers reach this site; SettleKing returns them to <PUBLIC_URL>/?booking=<id>
PUBLIC_URL=https://dance.example.com
STUDIO_NAME=Tempo Dance Studio
SETTLEKING_MERCHANT_NAME=Tempo Dance Studio

# The SettleKing environment this site talks to. These are the defaults: SettleKing's test
# environment (test cards and bank accounts, no real money). Change all four together for another
# environment.
SETTLEKING_API_URL=https://api-v2.stage.settleking.com
SETTLEKING_PAY_URL=https://pay.stage.settleking.com
SETTLEKING_CHECKOUT_URL=https://pay.stage.settleking.com/checkout
SETTLEKING_APP_URL=https://app.stage.settleking.com

# From Payments > Developer setup > API keys
SETTLEKING_CLIENT_ID=
SETTLEKING_CLIENT_SECRET=
# Offer only these methods on the hosted checkout (card, wallet). Empty = everything the merchant enabled.
SETTLEKING_PAYMENT_METHODS=
# From Developer setup > Webhooks (whsec_...)
SETTLEKING_WEBHOOK_SECRET=
# From Developer setup > Widgets; leave empty for hosted checkout only
SETTLEKING_WIDGET_ID=
SETTLEKING_PUBLISHABLE_KEY=
# Any long random string (openssl rand -base64 32); empty turns the /admin page off
ADMIN_TOKEN=
DATA_DIR=data
